+	int degradation = 0; // 0 = default, 1 = keep frame rate, 2 = balanced.
+};
+
+void SetDesktopCaptureOverrides(DesktopCaptureOverrides value);
+DesktopCaptureOverrides GetDesktopCaptureOverrides();
+
+// Live numbers of the current screen capture, for the client log.
+struct DesktopCaptureStats {
+	long long frames = 0; // Frames delivered since the app started.
+	int width = 0;
+	int height = 0;
+	int sendBitrateKbps = 0; // Send bandwidth estimate of the screencast.
+};
+
+void ReportDesktopCaptureFrame(int width, int height);
+void ReportDesktopCaptureSendBitrate(int kbps);
+DesktopCaptureStats GetDesktopCaptureStats();
+
