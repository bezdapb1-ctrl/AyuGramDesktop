+std::atomic<int> OverrideFps = 0;
+std::atomic<int> OverrideWidth = 0;
+std::atomic<int> OverrideHeight = 0;
+std::atomic<int> OverrideBitrateKbps = 0;
+
+} // namespace
+
+void SetDesktopCaptureOverrides(DesktopCaptureOverrides value) {
+    OverrideFps = value.fps;
+    OverrideWidth = value.width;
+    OverrideHeight = value.height;
+    OverrideBitrateKbps = value.maxBitrateKbps;
+}
+
+DesktopCaptureOverrides GetDesktopCaptureOverrides() {
+    return DesktopCaptureOverrides{
+        OverrideFps.load(),
+        OverrideWidth.load(),
+        OverrideHeight.load(),
+        OverrideBitrateKbps.load(),
+    };
+}
 
