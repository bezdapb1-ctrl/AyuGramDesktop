+
+// The default Windows timer ticks every ~15.6 ms, so a 16 ms delay often
+// becomes ~31 ms and 60 fps turns into ~30. Ask for 1 ms while capturing.
+void DesktopSourceRenderer::acquirePreciseTimer() {
+#ifdef WEBRTC_WIN
+    if (!_preciseTimer) {
+        _preciseTimer = (timeBeginPeriod(1) == TIMERR_NOERROR);
+    }
+#endif // WEBRTC_WIN
+}
+
+void DesktopSourceRenderer::releasePreciseTimer() {
+#ifdef WEBRTC_WIN
+    if (_preciseTimer) {
+        timeEndPeriod(1);
+        _preciseTimer = false;
+    }
+#endif // WEBRTC_WIN
+}
