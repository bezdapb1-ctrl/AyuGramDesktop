+
+void ReportDesktopCaptureFrame(int width, int height) {
+    ++StatsFrames;
+    StatsWidth = width;
+    StatsHeight = height;
+}
+
+void ReportDesktopCaptureSendBitrate(int kbps) {
+    StatsSendBitrateKbps = kbps;
+}
+
+DesktopCaptureStats GetDesktopCaptureStats() {
+    return DesktopCaptureStats{
+        StatsFrames.load(),
+        StatsWidth.load(),
+        StatsHeight.load(),
+        StatsSendBitrateKbps.load(),
+    };
+}
+
+void SetDesktopCaptureOverrides(DesktopCaptureOverrides value) {
+    OverrideFps = value.fps;
+    OverrideWidth = value.width;
+    OverrideHeight = value.height;
+    OverrideBitrateKbps = value.maxBitrateKbps;
+    OverrideStartBitrateKbps = value.startBitrateKbps;
+    OverrideDegradation = value.degradation;
+}
+
+DesktopCaptureOverrides GetDesktopCaptureOverrides() {
+    return DesktopCaptureOverrides{
+        OverrideFps.load(),
+        OverrideWidth.load(),
+        OverrideHeight.load(),
+        OverrideBitrateKbps.load(),
+        OverrideStartBitrateKbps.load(),
+        OverrideDegradation.load(),
+    };
+}
 
